{
  "compilerOptions": {
    "target": "ES2022", // Use modern JavaScript features
    "module": "ESNext", // Use ES modules (modern and standard)
    "moduleResolution": "Node", // Resolve modules like Node.js
    "strict": true, // Enable all strict type-checking options
    "noImplicitAny": true, // Disallow `any` unless explicitly stated
    "strictNullChecks": true, // Ensure null/undefined are handled explicitly
    "strictFunctionTypes": true, // Enforce function type compatibility
    "noImplicitReturns": true, // Ensure all code paths return a value
    "noFallthroughCasesInSwitch": true, // Prevent fallthrough in switch statements
    "esModuleInterop": true, // Allow default imports from CommonJS modules
    "forceConsistentCasingInFileNames": true, // Enforce consistent file casing
    "skipLibCheck": true, // Skip type checks for dependencies
    "resolveJsonModule": true, // Allow importing JSON files
    "outDir": "dist", // Output compiled files to `dist`
    "rootDir": "src", // Specify the source directory
    "types": ["node"] // Include Node.js types
  },
  "include": ["src/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist"] // Exclude dependencies
}
